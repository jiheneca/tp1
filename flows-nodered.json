        "func": "const bpm = Number(msg.payload);\nif (isNaN(bpm) || bpm <= 0) {\n    return null; // mesure invalide (capteur sans doigt, etc.)\n}\nconst seuil = flow.get('seuil') || 100;\nconst alarme = flow.get('alarme') || false;\nconst acquitte = flow.get('acquitte') || false;\n\nconst sortieBpm = { payload: bpm };\nlet sortieEtat = null;\nlet sortieLed = null;\n\nif (bpm > seuil) {\n    // Seuil dépassé : on déclenche seulement si pas déjà en alarme ET pas déjà acquittée\n    if (!alarme && !acquitte) {\n        flow.set('alarme', true);\n        sortieEtat = { payload: 'ALARME : ' + bpm + ' bpm' };\n        sortieLed = { payload: 'on' };\n    }\n} else {\n    // Retour à la normale : on réarme tout et on éteint la LED\n    if (alarme || acquitte) {\n        flow.set('alarme', false);\n        flow.set('acquitte', false);\n        sortieEtat = { payload: 'Normal' };\n        sortieLed = { payload: 'off' };\n    }\n}\nreturn [sortieBpm, sortieEtat, sortieLed];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
