        "z": "hospital_tab",
        "name": "Etat du bouton",
        "func": "const v = String(msg.payload).trim().toLowerCase();\nconst appuye = (v === '1' || v === 'true' || v === 'down' || v === 'pressed');\n\nconst precedent = flow.get('btnPrecedent') || false;\nflow.set('btnPrecedent', appuye);\n\nconst sortieTexte = { payload: appuye ? 'BOUTON APPUYE' : 'BOUTON RELACHE' };\n\n// Notification seulement au moment de l'appui\nlet sortieNotif = null;\nif (appuye && !precedent) {\n    sortieNotif = { payload: 'Le patient a appuye sur le bouton !' };\n}\n\nreturn [sortieTexte, sortieNotif];",
