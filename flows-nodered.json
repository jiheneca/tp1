    {
        "id": "function_hr",
        "type": "function",
        "z": "hospital_tab",
        "name": "Controle du seuil 100 BPM",
        "func": "\nconst seuil = 100;\n\n// Chien de garde : aucune donnée pendant 12 secondes\nconst ancien = context.get('wd');\nif (ancien) clearTimeout(ancien);\n\ncontext.set('wd', setTimeout(function () {\n    flow.set('alarme', false);\n    flow.set('acquitte', false);\n\n    node.send([\n        { payload: 0 },\n        { payload: '0' },\n        { payload: 'Aucune donnee recue du capteur (slave hors ligne ?)' }\n    ]);\n}, 12000));\n\nconst bpm = Number(msg.payload);\n\n// Vérification de la mesure\nif (!Number.isFinite(bpm) || bpm < 30 || bpm > 220) {\n\n    let compteur = context.get('invalidCount') || 0;\n    compteur++;\n\n    context.set('invalidCount', compteur);\n\n    // Une seule lecture invalide : on attend la prochaine\n    if (compteur < 2) {\n        return null;\n    }\n\n    // Deux lectures invalides consécutives\n    flow.set('alarme', false);\n    flow.set('acquitte', false);\n\n    return [\n        { payload: 0 },\n        { payload: '0' },\n        { payload: 'En attente de mesure (pas de doigt sur le capteur)' }\n    ];\n}\n\n// Une mesure valide : remise à zéro du compteur\ncontext.set('invalidCount', 0);\n\n// BPM normal\nif (bpm <= seuil) {\n    flow.set('alarme', false);\n    flow.set('acquitte', false);\n\n    return [\n        { payload: bpm },\n        { payload: '0' },\n        { payload: 'Pas de depassement du seuil configure' }\n    ];\n}\n\n// Seuil dépassé, mais alarme acquittée\nif (flow.get('acquitte')) {\n    return [\n        { payload: bpm },\n        { payload: '0' },\n        { payload: 'Alarme acquittee par le bouton (' + bpm + ' BPM)' }\n    ];\n}\n\n// Déclenchement de l'alarme\nflow.set('alarme', true);\n\nreturn [\n    { payload: bpm },\n    { payload: '1' },\n    { payload: 'ALERTE : Frequence cardiaque superieure a ' + seuil + ' BPM' }\n];\n",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 280,
        "wires": [
            [
                "gauge_hr"
            ],
            [
                "mqtt_led3"
            ],
            [
                "text_alarm"
            ]
        ]
    },
