        "z": "a1b2c3d4e5f60001",
        "name": "Bouton = acquitter",
        "func": "const etat = String(msg.payload);\nconst precedent = flow.get('btnPrecedent') || 'up';\nflow.set('btnPrecedent', etat);\n\n// Le bouton envoie \"down\"/\"up\" toutes les secondes :\n// on réagit uniquement au moment de l'appui (up -> down)\nif (etat === 'down' && precedent !== 'down') {\n    if (flow.get('alarme')) {\n        flow.set('alarme', false);\n        flow.set('acquitte', true);\n        return [{ payload: 'off' }, { payload: 'Alarme acquittée (bouton)' }];\n    }\n}\nreturn null;",
